      </body>
      <body name="right_finger" pos="0.006 0 0">
        <joint name="right" type="slide" axis="1 0 0" range="0 0.04" limited="true" damping="1"/>
        <geom type="box" pos="0 0 0.015" size="0.006 0.018 0.035" mass="0.06" rgba="0.2 0.25 0.3 1"/>
      </body>
    </body>
    <body name="red_block" pos="-0.2 -0.12 0.021"><freejoint/><geom type="box" size="0.02 0.02 0.02" mass="0.045" rgba="0.9 0.04 0.03 1"/></body>
    <body name="blue_block" pos="0 -0.12 0.021"><freejoint/><geom type="box" size="0.02 0.02 0.02" mass="0.045" rgba="0.03 0.12 0.9 1"/></body>
    <body name="green_block" pos="0.2 -0.12 0.021"><freejoint/><geom type="box" size="0.02 0.02 0.02" mass="0.045" rgba="0.03 0.7 0.08 1"/></body>
    <geom name="red_plate" type="cylinder" pos="0.2 0.15 0.006" size="0.065 0.006" rgba="0.85 0.08 0.06 1"/>
    <geom name="blue_plate" type="cylinder" pos="-0.2 0.15 0.006" size="0.065 0.006" rgba="0.05 0.15 0.85 1"/>
    <geom name="green_plate" type="cylinder" pos="0 0.15 0.006" size="0.065 0.006" rgba="0.06 0.65 0.12 1"/>
  </worldbody>
  <actuator>
    <position name="x" joint="x" ctrlrange="-0.4 0.4"/>
    <position name="y" joint="y" ctrlrange="-0.28 0.28"/>
    <position name="z" joint="z" ctrlrange="-0.185 0.15"/>
    <position name="left" joint="left" kp="120" kv="5" forcerange="-6 6" ctrlrange="0 0.04"/>
    <position name="right" joint="right" kp="120" kv="5" forcerange="-6 6" ctrlrange="0 0.04"/>
  </actuator>
</mujoco>
