# arm_base: absolute TCP pose in this arm's mounting base (same as Quanta).
# tcp: relative transform in the starting TCP frame. Full scoped frame IDs accepted.
# base: legacy absolute pose in ALOHA's shared table base.
string session_id
string reference_frame
geometry_msgs/Pose target
float64 duration
---
string receipt_json
---
# Measured TCP pose in this arm's arm_base, metres and quaternion xyzw.
geometry_msgs/Pose current_pose
float64 position_error
float64 orientation_error
string phase
